#!/usr/bin/env python3
"""slp-journal: versioned room message envelope + append-only durable journal (stdlib only).

Every mutating operation (dedup lookup, transition validation, seq allocation, append, fsync)
runs under ONE exclusive flock on <journal>.lock. See docs/ROOM_JOURNAL.md.
Exit codes: 0 ok, 2 usage, 3 rejected (reason in JSON on stdout), 4 journal corrupt/unusable.
"""
import argparse
import datetime
import errno
import fcntl
import hashlib
import json
import os
import posixpath
import re
import subprocess
import sys
import tempfile
import uuid

ENVELOPE_VERSION = 1
SIGNALS = ["CANDIDATE", "REVIEW", "REOPEN_REQUEST", "DEPENDENCY_REQUEST", "BLOCKED", "QUESTION", "ACK",
           "ACCEPT", "REJECT", "REVISED BRIEF", "HOLD", "ANSWER", "DEFER",
           "DONE", "STATUS", "DECISION_NEEDED", "BRIEF"]
REVIEW_KINDS = ["candidate", "plan", "watch", "other"]
CANDIDATE_REQUIRED_SIGNALS = ["CANDIDATE", "ACCEPT", "REJECT"]
REQUIRED = ["version", "roomId", "taskId", "messageId", "causationId", "senderAgentId",
            "recipientAgentId", "signal", "createdAt", "payload"]
OPTIONAL = ["candidateId"]
ID_PATTERN = r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
ID_MAXLEN = 128
CANDIDATE_ID_PATTERN = r"^[0-9a-f]{64}$"
TIME_PATTERN = r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,9})?Z$"
PAYLOAD_MAX_BYTES = 16384
DELIVERY_STATES = ["recorded", "delivered", "processing", "processed"]

ID_RE = re.compile(ID_PATTERN)
CID_RE = re.compile(CANDIDATE_ID_PATTERN)
TIME_RE = re.compile(TIME_PATTERN)
HEX_RE = re.compile(r"^[0-9a-f]{7,64}$")


class Reject(Exception):
    def __init__(self, reason, detail=""):
        super().__init__(reason)
        self.reason, self.detail = reason, detail


class Corrupt(Exception):
    def __init__(self, msg, reason="journal-corrupt"):
        super().__init__(msg)
        self.reason = reason


def canon(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def dedup_canon(obj):
    """Identity for retries: everything but createdAt (a retry regenerates the clock)."""
    return canon({k: v for k, v in obj.items() if k != "createdAt"})


def _is_id(v):
    return isinstance(v, str) and ID_RE.match(v) is not None


def validate_envelope(env):
    if not isinstance(env, dict):
        raise Reject("not-an-object")
    for k in REQUIRED:
        if k not in env:
            raise Reject("missing-field", k)
    for k in env:
        if k not in REQUIRED and k not in OPTIONAL:
            raise Reject("unknown-field", k)
    v = env["version"]
    if isinstance(v, bool) or v != ENVELOPE_VERSION or not isinstance(v, int):
        raise Reject("bad-version", repr(v))
    for k in ("roomId", "taskId", "messageId", "senderAgentId", "recipientAgentId"):
        if not _is_id(env[k]):
            raise Reject("bad-id", k)
    if env["causationId"] is not None and not _is_id(env["causationId"]):
        raise Reject("bad-id", "causationId")
    if env["signal"] not in SIGNALS:
        raise Reject("bad-signal", repr(env["signal"]))
    t = env["createdAt"]
    if not isinstance(t, str) or not TIME_RE.match(t):
        raise Reject("bad-createdAt", "RFC3339 UTC with Z required")
    try:
        datetime.datetime.strptime(t.rstrip("Z").split(".")[0], "%Y-%m-%dT%H:%M:%S")
    except ValueError:
        raise Reject("bad-createdAt", "not a real date-time")
    if not isinstance(env["payload"], dict):
        raise Reject("bad-payload", "must be an object")
    if len(canon(env["payload"]).encode()) > PAYLOAD_MAX_BYTES:
        raise Reject("payload-too-large", "limit %d bytes" % PAYLOAD_MAX_BYTES)
    sig = env["signal"]
    has = "candidateId" in env
    if has and (not isinstance(env["candidateId"], str) or not CID_RE.match(env["candidateId"])):
        raise Reject("bad-candidateId", "64 lowercase hex chars")
    if sig == "REVIEW":
        kind = env["payload"].get("kind")
        if kind not in REVIEW_KINDS:
            raise Reject("bad-review-kind", "payload.kind must be one of %s" % REVIEW_KINDS)
        if kind == "candidate" and not has:
            raise Reject("missing-field", "candidateId")
        if kind != "candidate" and has:
            raise Reject("unexpected-candidateId", "only candidate REVIEWs carry a candidate")
    elif sig in CANDIDATE_REQUIRED_SIGNALS and not has:
        raise Reject("missing-field", "candidateId")


def norm_rel(p):
    if not isinstance(p, str) or not p or p.startswith("/") or "\x00" in p:
        raise Reject("bad-path", repr(p))
    n = posixpath.normpath(p)
    if n == ".." or n.startswith("../"):
        raise Reject("bad-path", "escapes: %s" % p)
    return n


def canonical_identity(ident):
    if not isinstance(ident, dict):
        raise Reject("bad-identity", "must be an object")
    allowed = {"base", "commit", "patchSha256", "changedPaths", "evidenceRefs"}
    extra = set(ident) - allowed
    if extra:
        raise Reject("bad-identity", "unknown keys %s" % sorted(extra))
    base = ident.get("base")
    if not isinstance(base, str) or not base or len(base) > 200:
        raise Reject("bad-identity", "base")
    out = {"base": base}
    c, ps = ident.get("commit"), ident.get("patchSha256")
    if (c is None) == (ps is None):
        raise Reject("bad-identity", "exactly one of commit, patchSha256")
    if c is not None:
        if not isinstance(c, str) or not HEX_RE.match(c):
            raise Reject("bad-identity", "commit")
        out["commit"] = c
    else:
        if not isinstance(ps, str) or not CID_RE.match(ps):
            raise Reject("bad-identity", "patchSha256")
        out["patchSha256"] = ps
    cp = ident.get("changedPaths")
    if not isinstance(cp, list) or not cp:
        raise Reject("bad-identity", "changedPaths must be a non-empty list")
    out["changedPaths"] = sorted({norm_rel(p) for p in cp})
    ev = ident.get("evidenceRefs", [])
    if not isinstance(ev, list) or any(not isinstance(e, str) or not e or len(e) > 512 for e in ev):
        raise Reject("bad-identity", "evidenceRefs")
    out["evidenceRefs"] = sorted(set(ev))
    return out


def candidate_id(ident):
    return hashlib.sha256(canon(canonical_identity(ident)).encode()).hexdigest()


def canon_scope(root, paths):
    if not isinstance(root, str) or not os.path.isabs(root):
        raise Reject("bad-scope", "root must be an absolute path")
    if not isinstance(paths, list) or not paths:
        raise Reject("bad-scope", "paths must be a non-empty list")
    rootc = os.path.realpath(root)
    out = set()
    for p in paths:
        if not isinstance(p, str) or not p or "\x00" in p:
            raise Reject("bad-scope", repr(p))
        full = os.path.realpath(p if os.path.isabs(p) else os.path.join(rootc, p))
        if full != rootc and not full.startswith(rootc + os.sep):
            raise Reject("scope-escape", p)
        out.add(os.path.relpath(full, rootc))
    rels = sorted(out)
    return rootc, rels


def _parts(rel):
    return () if rel == "." else tuple(rel.split(os.sep))


def abs_paths(rootc, rels):
    return [rootc if r == "." else os.path.join(rootc, r) for r in rels]


def abs_overlap(a, b):
    for x in a:
        for y in b:
            px, py = tuple(c for c in x.split(os.sep) if c), tuple(c for c in y.split(os.sep) if c)
            n = min(len(px), len(py))
            if px[:n] == py[:n]:
                return True
    return False


def paths_overlap(a, b):
    for x in a:
        for y in b:
            px, py = _parts(x), _parts(y)
            n = min(len(px), len(py))
            if px[:n] == py[:n]:
                return True
    return False


# ---------------------------------------------------------------- state fold

TERMINAL = ("ACCEPTED", "CANCELLED", "REVIEWED")
CAND_FROM = ("ASSIGNED", "RUNNING", "NEEDS_REPAIR", "CANDIDATE_READY", "REVIEWING")
PEER_SIGNALS = ("BLOCKED", "QUESTION", "DEPENDENCY_REQUEST", "REOPEN_REQUEST")
DISPOSITIONS = ("ANSWER", "HOLD", "REVISED BRIEF", "DEFER")
PEER_CLASS = ("CANDIDATE", "REVIEW", "REOPEN_REQUEST", "DEPENDENCY_REQUEST", "BLOCKED", "QUESTION")
LEAD_CLASS = ("BRIEF", "ACCEPT", "REJECT", "REVISED BRIEF", "HOLD", "ANSWER", "DEFER")
UNTRACKED = ("DONE", "STATUS", "DECISION_NEEDED", "ACK")
CONTROL_ACTIONS = ["revoke", "transfer", "cancel", "reconcile", "lead"]
CONTROL_REQUIRED = ["controlId", "roomId", "by", "action", "createdAt", "params"]
CONTROL_OPTIONAL = ["taskId"]
GIT_TIMEOUT = 15


def new_state():
    return {"lastSeq": 0, "tasks": {}, "messages": {}, "candidates": {}, "reviews": {}, "openSignals": {},
            "roomLeads": {}, "controls": {}}


def parse_ts(s):
    return datetime.datetime.strptime(s.rstrip("Z").split(".")[0], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)


def valid_ts(s):
    if not isinstance(s, str) or not TIME_RE.match(s):
        return False
    try:
        parse_ts(s)
    except ValueError:
        return False
    return True


def git_toplevel(rootc):
    try:
        r = subprocess.run(["git", "-C", rootc, "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                           timeout=GIT_TIMEOUT)
        if r.returncode == 0 and r.stdout.strip():
            return os.path.realpath(r.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        pass
    return rootc


def commit_exists(root, sha):
    try:
        return subprocess.run(["git", "-C", root, "cat-file", "-e", sha + "^{commit}"], capture_output=True,
                              timeout=GIT_TIMEOUT).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def file_sha256(path):
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for b in iter(lambda: f.read(1 << 20), b""):
                h.update(b)
    except OSError:
        return None
    return h.hexdigest()


def _task(st, env):
    t = st["tasks"].get(env["taskId"])
    if t is None:
        raise Reject("unknown-task", env["taskId"])
    if t["roomId"] != env["roomId"]:
        raise Reject("room-mismatch", env["roomId"])
    return t


def _lead(st, room, who):
    if st["roomLeads"].get(room) != who:
        raise Reject("not-coordinator", "%s does not coordinate room %s (coordinator: %s)" % (who, room, st["roomLeads"].get(room)))


def _owner(t, who):
    if t["owner"] is None or who != t["owner"]:
        raise Reject("not-owner", who)


def _illegal(t, what):
    raise Reject("illegal-transition", "%s from %s" % (what, t["status"]))


def _hold_fields(p, who):
    o, rc = p.get("owner"), p.get("returnCondition")
    if not _is_id(o):
        raise Reject("missing-field", "payload.owner (agent id) is required for %s" % who)
    if not isinstance(rc, str) or not rc.strip() or len(rc) > 500:
        raise Reject("missing-field", "payload.returnCondition (non-empty string) is required for %s" % who)


def _scope_free(st, absp, ignore_task=None):
    for tid, o in st["tasks"].items():
        if tid == ignore_task or o["scopeReleased"] or o["writeScope"] is None:
            continue
        if abs_overlap(absp, o["writeScope"]["absPaths"]):
            raise Reject("scope-conflict", "overlaps unreleased scope of task %s owned by %s" % (tid, o["owner"]))


def check_brief(st, env):
    p, room = env["payload"], env["roomId"]
    if env["taskId"] in st["tasks"]:
        raise Reject("task-exists", env["taskId"])
    if env["senderAgentId"] == env["recipientAgentId"]:
        raise Reject("owner-is-recorder", "the recorder of a BRIEF cannot be its owner (source write owner != coordinator)")
    lead = st["roomLeads"].get(room)
    if lead is not None and lead != env["senderAgentId"]:
        raise Reject("not-coordinator", "room %s is coordinated by %s" % (room, lead))
    kind = p.get("kind", "work")
    if kind not in ("work", "review"):
        raise Reject("bad-brief-kind", repr(kind))
    extra = {}
    if kind == "review":
        if "writeScope" in p or "dependsOn" in p or "lease" in p:
            raise Reject("review-has-scope", "a review task is read-only: no writeScope, dependsOn or lease")
        cid = env.get("candidateId")
        if cid is not None:
            c = st["candidates"].get(cid)
            if c is None:
                raise Reject("unknown-candidate", cid)
            tt = st["tasks"][c["taskId"]]
            if tt["roomId"] != room:
                raise Reject("room-mismatch", tt["roomId"])
            if tt["currentCandidate"] != cid or tt["status"] not in ("CANDIDATE_READY", "REVIEWING"):
                raise Reject("stale-candidate", "candidate is not the current, undisposed candidate of task %s" % c["taskId"])
        return extra
    if "candidateId" in env:
        raise Reject("unexpected-candidateId", "only review BRIEFs name a candidate")
    ws = p.get("writeScope")
    if not isinstance(ws, dict) or set(ws) != {"root", "paths"}:
        raise Reject("bad-scope", "payload.writeScope = {root, paths[]} required")
    rootc, paths = canon_scope(ws["root"], ws["paths"])
    absp = abs_paths(rootc, paths)
    _scope_free(st, absp)
    extra["resolvedScope"] = {"root": rootc, "paths": paths, "absPaths": absp, "rootId": git_toplevel(rootc)}
    lease = p.get("lease")
    if lease is not None and (not isinstance(lease, dict) or set(lease) != {"expiresAt"} or not valid_ts(lease["expiresAt"])):
        raise Reject("bad-lease", "payload.lease = {expiresAt: RFC3339 UTC Z}")
    deps = p.get("dependsOn", [])
    if not isinstance(deps, list) or len(deps) > 16:
        raise Reject("bad-dependency", "payload.dependsOn must be a list of at most 16 {taskId, candidateId}")
    checked = []
    for d in deps:
        if not isinstance(d, dict) or set(d) != {"taskId", "candidateId"} or not _is_id(d["taskId"]) \
                or not isinstance(d["candidateId"], str) or not CID_RE.match(d["candidateId"]):
            raise Reject("bad-dependency", "each dependency is {taskId, candidateId}")
        u = st["tasks"].get(d["taskId"])
        if u is None or u["roomId"] != room or u["kind"] != "work":
            raise Reject("dependency-unknown", d["taskId"])
        if u["acceptedCandidate"] is None:
            raise Reject("dependency-not-accepted", "task %s is %s" % (d["taskId"], u["status"]))
        if u["acceptedCandidate"] != d["candidateId"]:
            raise Reject("dependency-wrong-candidate", "task %s accepted %s" % (d["taskId"], u["acceptedCandidate"]))
        c = st["candidates"][d["candidateId"]]
        root = u["writeScope"]["root"]
        if "commit" in c["identity"]:
            if not commit_exists(root, c["identity"]["commit"]):
                raise Reject("dependency-artifact-inaccessible", "commit %s not found in %s" % (c["identity"]["commit"], root))
            how = "commit"
        else:
            pf = c.get("patchFile")
            if not pf or file_sha256(pf if os.path.isabs(pf) else os.path.join(root, pf)) != c["identity"]["patchSha256"]:
                raise Reject("dependency-artifact-inaccessible", "patch file missing or sha256 differs")
            how = "patch"
        checked.append({"taskId": d["taskId"], "candidateId": d["candidateId"], "artifact": how})
    extra["resolvedDeps"] = checked
    return extra


def check_transition(st, env):
    sig, p, who = env["signal"], env["payload"], env["senderAgentId"]
    if sig == "BRIEF":
        return check_brief(st, env)
    if sig in UNTRACKED:
        return {}
    if env["taskId"] not in st["tasks"] and not (sig in ("CANDIDATE", "ACCEPT", "REJECT") or "candidateId" in env):
        return {}  # raw append of a signal for a task with no BRIEF: recorded, tracked nowhere (seat commands refuse it)
    t = _task(st, env)
    if sig == "CANDIDATE":
        if t["kind"] != "work":
            raise Reject("review-task-no-candidate", "review-only tasks end with their REVIEW")
        if t["status"] in TERMINAL:
            raise Reject("task-closed", t["status"])
        _owner(t, who)
        if t["status"] not in CAND_FROM:
            _illegal(t, "CANDIDATE")
        cid = env["candidateId"]
        if candidate_id(p.get("identity")) != cid:
            raise Reject("candidate-id-mismatch", "candidateId is not sha256 of the canonical identity")
        if cid in st["candidates"]:
            raise Reject("candidate-exists", cid)
        pf = p.get("patchFile")
        if pf is not None and (not isinstance(pf, str) or not pf or len(pf) > 512 or "\x00" in pf):
            raise Reject("bad-patchFile", "payload.patchFile must be a path string")
        return {}
    if sig == "REVIEW":
        return check_review(st, env, t)
    if sig in ("ACCEPT", "REJECT"):
        _lead(st, env["roomId"], who)
        cid = env["candidateId"]
        c = st["candidates"].get(cid)
        if c is None:
            raise Reject("unknown-candidate", cid)
        if c["taskId"] != env["taskId"]:
            raise Reject("cross-task-candidate", c["taskId"])
        if t["acceptedCandidate"]:
            raise Reject("already-accepted", t["acceptedCandidate"])
        if t["currentCandidate"] != cid:
            raise Reject("stale-candidate", "current is %s" % t["currentCandidate"])
        if t["status"] not in ("CANDIDATE_READY", "REVIEWING"):
            _illegal(t, sig)
        if sig == "ACCEPT":
            if t["status"] == "REVIEWING":
                raise Reject("under-review", "a review of this candidate is still open")
            rid, waived = p.get("reviewMessageId"), p.get("reviewWaived")
            if rid is not None:
                if st["reviews"].get(rid) != (env["taskId"], cid):
                    raise Reject("review-mismatch", "reviewMessageId is not a REVIEW of exactly this candidate")
            elif not (isinstance(waived, str) and waived.strip()):
                raise Reject("review-required", "payload.reviewMessageId or non-empty payload.reviewWaived")
        else:
            own = p.get("ownership", "keep")
            if own not in ("keep", "release", "reassign"):
                raise Reject("bad-ownership", "payload.ownership is keep | release | reassign")
            if own == "reassign":
                nxt = p.get("reassignTo")
                if not _is_id(nxt) or nxt == who:
                    raise Reject("bad-ownership", "payload.reassignTo must be an agent id other than the coordinator")
        return {}
    if sig in PEER_SIGNALS:
        if t["status"] in TERMINAL:
            raise Reject("task-closed", t["status"])
        _owner(t, who)
        if sig == "BLOCKED":
            if t["status"] not in ("ASSIGNED", "RUNNING", "NEEDS_REPAIR"):
                _illegal(t, sig)
            _hold_fields(p, sig)
        return {}
    _lead(st, env["roomId"], who)
    cause = env.get("causationId")
    if cause is not None and st["messages"].get(cause, {}).get("taskId") != env["taskId"]:
        raise Reject("unknown-cause", "causationId must name a recorded message of this task")
    if sig == "DEFER":
        if t["status"] not in ("ASSIGNED", "RUNNING", "NEEDS_REPAIR", "BLOCKED"):
            _illegal(t, sig)
        _hold_fields(p, sig)
    return {}


def check_review(st, env, t):
    who, cid = env["senderAgentId"], env.get("candidateId")
    cand_kind = env["payload"]["kind"] == "candidate"
    if t["kind"] == "review":
        _owner(t, who)
        if t["status"] not in ("ASSIGNED", "RUNNING"):
            _illegal(t, "REVIEW")
        if t["reviewOf"] is not None and (not cand_kind or cid != t["reviewOf"]):
            raise Reject("review-mismatch", "this task reviews candidate %s" % t["reviewOf"])
        if t["reviewOf"] is None and cand_kind:
            raise Reject("review-mismatch", "this review task names no candidate")
        return {}
    if cand_kind:
        c = st["candidates"].get(cid)
        if c is None:
            raise Reject("unknown-candidate", cid)
        if c["taskId"] != env["taskId"]:
            raise Reject("cross-task-candidate", c["taskId"])
        return {}
    _owner(t, who)
    if t["status"] in TERMINAL:
        raise Reject("task-closed", t["status"])
    return {}


def _process(st, mid):
    m = st["messages"][mid]
    if m["state"] in ("recorded", "delivered"):
        m["state"], m["implicit"] = "processed", True


def _process_task(st, taskid, classes, before, only=None):
    """Implicit processing by causation: no seat runs `deliver`; the next signal on the task is the proof."""
    for mid, m in st["messages"].items():
        if m["taskId"] == taskid and m["signal"] in classes and m["seq"] < before and (only is None or mid == only):
            _process(st, mid)


def _close_signals(st, taskid, cause=None):
    for mid in [m for m, s in st["openSignals"].items()
                if s["taskId"] == taskid and (cause is None or m == cause)]:
        del st["openSignals"][mid]
        _process(st, mid)


def _dispose_candidates(st, taskid):
    """ACCEPT / REJECT dispose the task's CANDIDATE signals and the REVIEWs of its candidates recorded so far."""
    for mid in [m for m, s in st["openSignals"].items()
                if (s["taskId"] == taskid and s["signal"] == "CANDIDATE")
                or (s.get("candidateId") in st["candidates"] and st["candidates"][s["candidateId"]]["taskId"] == taskid
                    and s["signal"] == "REVIEW")]:
        del st["openSignals"][mid]
        _process(st, mid)


def _release(t, event, seq, owner=None):
    t["scopeReleased"] = True
    if owner is None:
        t["lastOwner"] = t["owner"]
    t["owner"] = owner
    t["ownership"] = {"event": event, "seq": seq}


def apply_message(st, rec):
    env, seq = rec["envelope"], rec["seq"]
    sig, p, who, mid = env["signal"], env["payload"], env["senderAgentId"], env["messageId"]
    st["messages"][mid] = {"seq": seq, "signal": sig, "state": "recorded", "canon": dedup_canon(env), "taskId": env["taskId"],
                           "roomId": env["roomId"], "sender": who, "recipient": env["recipientAgentId"]}
    if sig == "BRIEF":
        rs = rec.get("resolvedScope")
        room = env["roomId"]
        st["roomLeads"].setdefault(room, who)
        kind = p.get("kind", "work")
        lease = p.get("lease")
        st["tasks"][env["taskId"]] = {
            "roomId": room, "kind": kind, "owner": env["recipientAgentId"], "lastOwner": env["recipientAgentId"], "status": "ASSIGNED", "startMsg": mid,
            "writeScope": None if rs is None else {"root": rs["root"], "paths": list(rs["paths"]),
                                                   "absPaths": list(rs["absPaths"]), "rootId": rs.get("rootId", rs["root"])},
            "scopeReleased": rs is None, "ownership": {"event": "granted", "seq": seq},
            "lease": lease["expiresAt"] if lease else None, "dependsOn": rec.get("resolvedDeps", []),
            "reviewOf": env.get("candidateId") if kind == "review" else None, "openReviews": [],
            "candidates": [], "currentCandidate": None, "acceptedCandidate": None,
            "acceptances": [], "rejections": [], "block": None}
        if kind == "review" and env.get("candidateId"):
            tt = st["tasks"][st["candidates"][env["candidateId"]]["taskId"]]
            tt["openReviews"].append(env["taskId"])
            tt["status"] = "REVIEWING"
        return
    t = st["tasks"].get(env["taskId"])
    if t is None:
        return
    if sig in PEER_CLASS:
        _process_task(st, env["taskId"], LEAD_CLASS, seq)
    elif sig == "ACK" or sig in ("ACCEPT", "DEFER"):
        _process(st, mid)  # ACCEPT / DEFER expect only an ACK, which is not journaled
    if who == t["owner"] and t["status"] in ("ASSIGNED", "NEEDS_REPAIR") and (sig in PEER_SIGNALS or sig in ("CANDIDATE", "REVIEW")):
        t["status"] = "RUNNING"
    if sig == "CANDIDATE":
        cid = env["candidateId"]
        t["candidates"].append(cid)
        t["currentCandidate"] = cid
        t["status"], t["openReviews"] = "CANDIDATE_READY", []
        st["candidates"][cid] = {"taskId": env["taskId"], "messageId": mid, "seq": seq,
                                 "identity": canonical_identity(p["identity"]), "patchFile": p.get("patchFile")}
        st["openSignals"][mid] = {"taskId": env["taskId"], "signal": sig, "candidateId": cid}
    elif sig == "REVIEW":
        cid = env.get("candidateId")
        if t["kind"] == "review":
            t["status"] = "REVIEWED"
            if cid:
                target = st["candidates"][cid]["taskId"]
                st["reviews"][mid] = (target, cid)
                tt = st["tasks"][target]
                if env["taskId"] in tt["openReviews"]:
                    tt["openReviews"].remove(env["taskId"])
                if tt["status"] == "REVIEWING" and not tt["openReviews"]:
                    tt["status"] = "CANDIDATE_READY"
            st["openSignals"][mid] = {"taskId": env["taskId"], "signal": sig, "candidateId": cid}
        elif cid:
            st["reviews"][mid] = (env["taskId"], cid)
            st["openSignals"][mid] = {"taskId": env["taskId"], "signal": sig, "candidateId": cid}
        else:
            st["openSignals"][mid] = {"taskId": env["taskId"], "signal": sig, "candidateId": None}
    elif sig == "ACCEPT":
        cid = env["candidateId"]
        t["acceptedCandidate"], t["status"], t["openReviews"] = cid, "ACCEPTED", []
        _release(t, "released-by-accept", seq, t["owner"])
        t["acceptances"].append({"candidateId": cid, "messageId": mid, "seq": seq})
        _process_task(st, env["taskId"], ("CANDIDATE", "REVIEW"), seq)
        _dispose_candidates(st, env["taskId"])
    elif sig == "REJECT":
        cid = env["candidateId"]
        t["rejections"].append({"candidateId": cid, "messageId": mid, "seq": seq})
        t["currentCandidate"], t["openReviews"] = None, []
        own = p.get("ownership", "keep")
        if own == "release":
            t["status"] = "READY"
            _release(t, "released-by-reject", seq)
        else:
            t["status"], t["startMsg"] = "NEEDS_REPAIR", mid
            t["ownership"] = {"event": "kept", "seq": seq}
            if own == "reassign":
                t["owner"] = p["reassignTo"]
                t["ownership"] = {"event": "reassigned", "seq": seq}
        _process_task(st, env["taskId"], ("CANDIDATE", "REVIEW"), seq)
        _dispose_candidates(st, env["taskId"])
    elif sig in PEER_SIGNALS:
        st["openSignals"][mid] = {"taskId": env["taskId"], "signal": sig, "candidateId": None}
        if sig == "BLOCKED":
            t["status"], t["block"] = "BLOCKED", {"owner": p["owner"], "returnCondition": p["returnCondition"], "messageId": mid}
    elif sig in DISPOSITIONS:
        cause = env.get("causationId")
        _process_task(st, env["taskId"], PEER_CLASS, seq, only=cause)
        _close_signals(st, env["taskId"], cause=cause)
        if sig == "DEFER":
            t["status"], t["block"] = "DEFERRED", {"owner": p["owner"], "returnCondition": p["returnCondition"], "messageId": mid}
        elif sig in ("ANSWER", "REVISED BRIEF") and t["status"] in ("BLOCKED", "DEFERRED"):
            t["status"], t["startMsg"], t["block"] = "ASSIGNED", mid, None


def _drop_review(st, tid, t):
    """A review task that stops reviewing no longer holds its target in REVIEWING."""
    if t["kind"] != "review" or t["reviewOf"] is None:
        return
    tt = st["tasks"][st["candidates"][t["reviewOf"]]["taskId"]]
    if tid in tt["openReviews"]:
        tt["openReviews"].remove(tid)
    if tt["status"] == "REVIEWING" and not tt["openReviews"]:
        tt["status"] = "CANDIDATE_READY"


def check_control(st, c):
    act, p, by, room = c["action"], c["params"], c["by"], c["roomId"]
    if act == "lead":
        if not _is_id(p.get("from")) or not _is_id(p.get("to")) or p["from"] == p["to"]:
            raise Reject("bad-control", "lead needs params.from and params.to (distinct agent ids)")
        if st["roomLeads"].get(room) != p["from"]:
            raise Reject("not-coordinator", "room %s is coordinated by %s, not %s" % (room, st["roomLeads"].get(room), p["from"]))
        if by not in (p["from"], p["to"]):
            raise Reject("not-coordinator", "only the outgoing or incoming Lead records a Lead transfer")
        for tid, t in st["tasks"].items():
            if t["roomId"] == room and t["owner"] == p["to"] and not t["scopeReleased"]:
                raise Reject("owner-is-recorder", "incoming Lead owns the scope of task %s" % tid)
        return
    _lead(st, room, by)
    t = st["tasks"].get(c.get("taskId"))
    if t is None:
        raise Reject("unknown-task", str(c.get("taskId")))
    if t["roomId"] != room:
        raise Reject("room-mismatch", room)
    if t["status"] in TERMINAL:
        raise Reject("illegal-transition", "%s from %s" % (act, t["status"]))
    if act == "revoke" and t["owner"] is None:
        raise Reject("illegal-transition", "revoke: task has no owner")
    if act == "transfer":
        to = p.get("to")
        if not _is_id(to) or to == by:
            raise Reject("bad-control", "transfer needs params.to (an agent id other than the coordinator)")
        if to == t["owner"]:
            raise Reject("bad-control", "task is already owned by %s" % to)
        if t["writeScope"] is not None:
            _scope_free(st, t["writeScope"]["absPaths"], ignore_task=c["taskId"])
        if t["kind"] == "review" and t["reviewOf"] is not None and t["status"] == "READY":
            tt = st["tasks"][st["candidates"][t["reviewOf"]]["taskId"]]
            if tt["currentCandidate"] != t["reviewOf"] or tt["status"] not in ("CANDIDATE_READY", "REVIEWING"):
                raise Reject("stale-candidate", "the candidate under review is no longer current")
    if act in ("transfer", "reconcile") and "lease" in p and p["lease"] is not None and not valid_ts(p["lease"]):
        raise Reject("bad-lease", "params.lease must be RFC3339 UTC Z or null")


def apply_control(st, rec):
    c, seq = rec, rec["seq"]
    st["controls"][c["controlId"]] = {"seq": seq, "canon": rec["canon"]}
    act, p = c["action"], c["params"]
    if act == "lead":
        st["roomLeads"][c["roomId"]] = p["to"]
        return
    t = st["tasks"][c["taskId"]]
    if act in ("revoke", "cancel"):
        _drop_review(st, c["taskId"], t)
        t["status"] = "CANCELLED" if act == "cancel" else "READY"
        _release(t, "cancelled" if act == "cancel" else "revoked", seq)
        t["currentCandidate"], t["openReviews"], t["block"], t["lease"] = None, [], None, None
        _process_task(st, c["taskId"], PEER_CLASS, seq)
        _close_signals(st, c["taskId"])
    elif act == "transfer":
        if t["kind"] == "review" and t["reviewOf"] is not None and t["status"] == "READY":
            tt = st["tasks"][st["candidates"][t["reviewOf"]]["taskId"]]
            tt["openReviews"].append(c["taskId"])
            tt["status"] = "REVIEWING"
        t["owner"], t["status"], t["startMsg"], t["block"] = p["to"], "ASSIGNED", None, None
        t["scopeReleased"] = t["writeScope"] is None
        t["ownership"] = {"event": "transferred", "seq": seq}
        t["currentCandidate"], t["openReviews"] = None, []
        t["lease"] = p.get("lease")
        _process_task(st, c["taskId"], PEER_CLASS, seq)
        _close_signals(st, c["taskId"])
    elif act == "reconcile":
        t["lease"] = p.get("lease")
        t["reconciledSeq"] = seq


def apply_record(st, rec):
    if rec["kind"] == "message":
        apply_message(st, rec)
    elif rec["kind"] == "control":
        apply_control(st, {**rec, "canon": dedup_canon(control_core(rec))})
    else:
        m = st["messages"][rec["messageId"]]
        m["state"] = rec["state"]
        t = st["tasks"].get(m["taskId"])
        if t is not None and t["startMsg"] == rec["messageId"] and t["status"] in ("ASSIGNED", "NEEDS_REPAIR"):
            t["status"] = "RUNNING"
    st["lastSeq"] = rec["seq"]


def control_core(rec):
    return {k: rec[k] for k in CONTROL_REQUIRED + CONTROL_OPTIONAL if k in rec}


def validate_control(c):
    if not isinstance(c, dict):
        raise Reject("not-an-object")
    for k in CONTROL_REQUIRED:
        if k not in c:
            raise Reject("missing-field", k)
    for k in c:
        if k not in CONTROL_REQUIRED and k not in CONTROL_OPTIONAL:
            raise Reject("unknown-field", k)
    for k in ("controlId", "roomId", "by") + (("taskId",) if "taskId" in c else ()):
        if not _is_id(c[k]):
            raise Reject("bad-id", k)
    if c["action"] not in CONTROL_ACTIONS:
        raise Reject("bad-control", "action must be one of %s" % CONTROL_ACTIONS)
    if c["action"] != "lead" and "taskId" not in c:
        raise Reject("missing-field", "taskId")
    if not valid_ts(c["createdAt"]):
        raise Reject("bad-createdAt", "RFC3339 UTC with Z required")
    if not isinstance(c["params"], dict) or len(canon(c["params"]).encode()) > PAYLOAD_MAX_BYTES:
        raise Reject("bad-payload", "params must be an object")


def fold(records):
    st = new_state()
    for rec in records:
        try:
            apply_record(st, rec)
        except (KeyError, TypeError, Reject) as e:
            raise Corrupt("seq %s: record does not fold (%s)" % (rec.get("seq"), e))
    return st


def task_view(t, now):
    v = dict(t)
    v["scopeHeld"] = not t["scopeReleased"]
    v["leaseExpired"] = bool(t["lease"] and parse_ts(t["lease"]) <= now and t["status"] not in TERMINAL)
    v["needsReconcile"] = v["leaseExpired"]
    return v


def public_state(st, now):
    msgs = st["messages"]
    tasks = {k: task_view(v, now) for k, v in st["tasks"].items()}
    return {
        "lastSeq": st["lastSeq"],
        "roomLeads": dict(st["roomLeads"]),
        "tasks": tasks,
        "openSignals": {m: dict(s) for m, s in st["openSignals"].items()},
        "unprocessed": sorted((m for m, v in msgs.items() if v["state"] in ("recorded", "delivered")), key=lambda m: msgs[m]["seq"]),
        "needsReconcile": sorted((m for m, v in msgs.items() if v["state"] == "processing"), key=lambda m: msgs[m]["seq"]),
        "tasksNeedReconcile": sorted(k for k, v in tasks.items() if v["needsReconcile"]),
        "messages": {m: {"seq": v["seq"], "signal": v["signal"], "state": v["state"]} for m, v in msgs.items()},
    }


def open_loops(st, lead, now, running=(), permission=()):
    rooms = {r for r, l in st["roomLeads"].items() if l == lead}
    if not rooms:
        raise Reject("unknown-lead", "%s coordinates no room in this journal" % lead)
    out = []
    for tid, t in sorted(st["tasks"].items()):
        if t["roomId"] not in rooms:
            continue
        v = task_view(t, now)
        if t["status"] not in TERMINAL:
            kind = {"CANDIDATE_READY": "candidate-undisposed", "REVIEWING": "candidate-undisposed"}.get(t["status"], "task-open")
            out.append({"type": kind, "taskId": tid, "detail": "%s owner=%s scope=%s" % (
                t["status"], t["owner"], "held" if v["scopeHeld"] else "released")})
        if v["scopeHeld"] and t["status"] in TERMINAL:
            out.append({"type": "unreleased-scope", "taskId": tid, "detail": t["status"]})
        if v["leaseExpired"]:
            out.append({"type": "lease-expired", "taskId": tid, "detail": "lease %s needs reconcile" % t["lease"]})
    for mid, sg in sorted(st["openSignals"].items(), key=lambda kv: st["messages"][kv[0]]["seq"]):
        if st["tasks"][sg["taskId"]]["roomId"] in rooms:
            out.append({"type": "signal-undisposed", "taskId": sg["taskId"], "detail": "%s %s" % (sg["signal"], mid)})
    for mid, m in sorted(st["messages"].items(), key=lambda kv: kv[1]["seq"]):
        if m["roomId"] not in rooms or m["signal"] in UNTRACKED:
            continue
        t = st["tasks"].get(m["taskId"])
        is_open = t is not None and t["status"] not in TERMINAL
        peer = m["signal"] in PEER_CLASS
        if m["state"] == "processing" and (peer or is_open):
            out.append({"type": "message-needs-reconcile", "taskId": m["taskId"], "detail": "%s %s" % (m["signal"], mid)})
        elif m["state"] in ("recorded", "delivered") and is_open and not peer:
            out.append({"type": "message-unprocessed", "taskId": m["taskId"], "detail": "%s %s (%s)" % (m["signal"], mid, m["state"])})
    for a in running:
        out.append({"type": "agent-running", "taskId": None, "detail": a})
    for a in permission:
        out.append({"type": "permission-pending", "taskId": None, "detail": a})
    return out


# ---------------------------------------------------------------- storage

def fsync_dir(d):
    fd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(fd)
    except OSError as e:
        if e.errno not in (errno.EINVAL, errno.ENOTSUP, errno.EOPNOTSUPP):
            raise
    finally:
        os.close(fd)


def fsync_ancestors(d):
    """fsync d and every ancestor up to the filesystem root, independent of any other writer."""
    while True:
        fsync_dir(d)
        parent = os.path.dirname(d)
        if parent == d:
            return
        d = parent


def make_dirs_durable(d):
    """Create missing levels one at a time (0700), fsyncing each new directory's containing directory."""
    missing = []
    while not os.path.isdir(d):
        missing.append(d)
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    for m in reversed(missing):
        try:
            os.mkdir(m, 0o700)
        except FileExistsError:
            pass
        fsync_dir(os.path.dirname(m))


def open_new_or_existing(path, flags):
    """Open read/write, creating 0600 if missing (directory durability: see Journal.__enter__)."""
    try:
        return os.open(path, flags | os.O_CREAT | os.O_EXCL, 0o600), True
    except FileExistsError:
        return os.open(path, flags), False


class Journal:
    def __init__(self, path, write):
        self.path, self.write, self.repaired = path, write, None

    def __enter__(self):
        # Resolve first: every alias of one journal must take the same lock.
        self.path = os.path.join(os.path.realpath(os.path.dirname(os.path.abspath(self.path))),
                                 os.path.basename(self.path))
        if os.path.islink(self.path):
            self.path = os.path.realpath(self.path)
        d = os.path.dirname(self.path)
        if self.write:
            make_dirs_durable(d)
        elif not os.path.isdir(d):
            raise Corrupt("journal directory does not exist")
        self.fd = None
        self.lfd, _ = open_new_or_existing(self.path + ".lock", os.O_RDWR)
        try:
            fcntl.flock(self.lfd, fcntl.LOCK_EX if self.write else fcntl.LOCK_SH)
            if self.write:
                self.fd, _ = open_new_or_existing(self.path, os.O_RDWR)
                # Whoever created the files, their directory entries are made durable under our
                # lock before this operation can acknowledge a write.
                fsync_ancestors(d)
            else:
                try:
                    self.fd = os.open(self.path, os.O_RDONLY)
                except FileNotFoundError:
                    self.fd = None
            if self.fd is not None:
                st = os.fstat(self.fd)
                if st.st_mode & 0o077:
                    if st.st_uid != os.geteuid():
                        raise Corrupt("journal is accessible by group/other and not owned by us", "journal-permissions")
                    os.fchmod(self.fd, 0o600)
            self.records, self.state = self._load()
        except BaseException:
            self.__exit__()
            raise
        return self

    def __exit__(self, *a):
        if self.fd is not None:
            os.close(self.fd)
        os.close(self.lfd)

    def _load(self):
        if self.fd is None:
            return [], fold([])
        os.lseek(self.fd, 0, os.SEEK_SET)
        chunks = []
        while True:
            b = os.read(self.fd, 1 << 20)
            if not b:
                break
            chunks.append(b)
        data = b"".join(chunks)
        end = data.rfind(b"\n") + 1
        torn = len(data) - end
        data = data[:end]
        recs, off = [], 0
        for line in data.split(b"\n")[:-1]:
            try:
                rec = json.loads(line)
                if (not isinstance(rec, dict) or rec.get("seq") != len(recs) + 1
                        or rec.get("kind") not in ("message", "delivery", "control") or not isinstance(rec.get("entryId"), str)):
                    raise ValueError("bad record shape or seq not gapless")
                if rec["kind"] == "message":
                    validate_envelope(rec["envelope"])
                elif rec["kind"] == "control":
                    validate_control(control_core(rec))
                elif rec.get("state") not in DELIVERY_STATES[1:] or rec.get("messageId") is None:
                    raise ValueError("bad delivery record")
            except (ValueError, KeyError, Reject) as e:
                raise Corrupt("corrupt record at seq %d, offset %d: %s" % (len(recs) + 1, off, e))
            recs.append(rec)
            off += len(line) + 1
        st = fold(recs)
        if torn:
            self.repaired = {"truncatedBytes": torn, "atOffset": end}
            if self.write:
                os.ftruncate(self.fd, end)
                os.fsync(self.fd)
        return recs, st

    def _append(self, rec):
        rec = {"seq": self.state["lastSeq"] + 1, "entryId": uuid.uuid4().hex, **rec,
               "recordedAt": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
        os.lseek(self.fd, 0, os.SEEK_END)
        line = (canon(rec) + "\n").encode()
        if os.write(self.fd, line) != len(line):
            raise Corrupt("short write")
        os.fsync(self.fd)
        apply_record(self.state, rec)
        return rec

    def append_message(self, env):
        validate_envelope(env)
        old = self.state["messages"].get(env["messageId"])
        if old is not None:
            if old["canon"] == dedup_canon(env):
                return {"ok": True, "duplicate": True, "seq": old["seq"]}
            raise Reject("conflict", "messageId already recorded with different content")
        extra = check_transition(self.state, env)
        rec = self._append({"kind": "message", "envelope": env, **extra})
        return {"ok": True, "duplicate": False, "seq": rec["seq"]}

    def append_control(self, c):
        validate_control(c)
        old = self.state["controls"].get(c["controlId"])
        if old is not None:
            if old["canon"] == dedup_canon(c):
                return {"ok": True, "duplicate": True, "seq": old["seq"]}
            raise Reject("conflict", "controlId already recorded with different content")
        check_control(self.state, c)
        rec = self._append({"kind": "control", **c})
        return {"ok": True, "duplicate": False, "seq": rec["seq"]}

    def deliver(self, message_id, state):
        if state not in DELIVERY_STATES[1:]:
            raise Reject("bad-delivery-state", state)
        m = self.state["messages"].get(message_id)
        if m is None:
            raise Reject("unknown-message", message_id)
        if m.get("implicit"):
            return {"ok": True, "duplicate": True, "state": m["state"], "implicit": True}
        cur, new = DELIVERY_STATES.index(m["state"]), DELIVERY_STATES.index(state)
        if new == cur:
            return {"ok": True, "duplicate": True, "state": state}
        if new < cur:
            raise Reject("state-regression", "%s -> %s" % (m["state"], state))
        if new != cur + 1:
            raise Reject("state-out-of-order", "%s -> %s" % (m["state"], state))
        rec = self._append({"kind": "delivery", "messageId": message_id, "state": state})
        return {"ok": True, "duplicate": False, "seq": rec["seq"], "state": state}


# ---------------------------------------------------------------- CLI

class Usage(Exception):
    pass


def out(obj, code=0):
    sys.stdout.write(json.dumps(obj, sort_keys=True) + "\n")
    sys.stdout.flush()
    return code


def line(text, code=0):
    sys.stdout.write(text + "\n")
    sys.stdout.flush()
    return code


def read_json(src):
    try:
        raw = sys.stdin.read() if src in (None, "-") else open(src, encoding="utf-8").read()
        return json.loads(raw)
    except (OSError, ValueError) as e:
        raise Reject("unreadable-json", str(e))


def contract():
    return {"version": ENVELOPE_VERSION, "required": REQUIRED, "optional": OPTIONAL, "signals": SIGNALS,
            "reviewKinds": REVIEW_KINDS, "candidateRequiredSignals": CANDIDATE_REQUIRED_SIGNALS,
            "idPattern": ID_PATTERN, "idMaxLength": ID_MAXLEN, "candidateIdPattern": CANDIDATE_ID_PATTERN,
            "timePattern": TIME_PATTERN, "payloadMaxBytes": PAYLOAD_MAX_BYTES}


def self_check():
    if sys.version_info < (3, 9):
        raise Corrupt("python >= 3.9 required")
    with tempfile.TemporaryDirectory() as d:
        fd = os.open(os.path.join(d, "l"), os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        os.close(fd)
    a = candidate_id({"base": "b", "commit": "abcdef1", "changedPaths": ["x/./y", "a"], "evidenceRefs": []})
    b = candidate_id({"base": "b", "commit": "abcdef1", "changedPaths": ["a", "x/y"]})
    if a != b:
        raise Corrupt("candidate id is not canonical")
    return {"ok": True, "python": sys.version.split()[0], "flock": True, "envelopeVersion": ENVELOPE_VERSION}


def iso(dt):
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def now_of(a):
    if a.now:
        if not valid_ts(a.now):
            raise Usage("--now must be RFC3339 UTC Z")
        return parse_ts(a.now)
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)


def seat(a, st, task):
    """(room, sender) for a seat command: flags, then SLP_ROOM / SLP_AGENT, then the task's own room."""
    sender = a.sender or os.environ.get("PASEO_AGENT_ID") or os.environ.get("SLP_AGENT")
    if not sender:
        raise Usage("--as AGENT, PASEO_AGENT_ID or SLP_AGENT required")
    room = a.room or os.environ.get("SLP_ROOM") or (st["tasks"][task]["roomId"] if task in st["tasks"] else None)
    if not room:
        raise Usage("--room ROOM or SLP_ROOM required")
    return room, sender


def build(j, a, task, signal, to=None, payload=None, cid=None):
    st = j.state
    room, sender = seat(a, st, task)
    if to is None:
        t = st["tasks"].get(task)
        if t is None:
            raise Reject("unknown-task", task)
        to = (t["owner"] or t["lastOwner"]) if sender == st["roomLeads"].get(room) else st["roomLeads"].get(room)
        if to is None:
            raise Reject("no-recipient", "the task has no owner / the room no coordinator to address")
    e = {"version": 1, "roomId": room, "taskId": task, "messageId": a.id or uuid.uuid4().hex, "causationId": a.cause,
         "senderAgentId": sender, "recipientAgentId": to, "signal": signal, "createdAt": iso(now_of(a)),
         "payload": {k: v for k, v in (payload or {}).items() if v is not None}}
    if cid:
        e["candidateId"] = cid
    return e


def sent(j, a, task, signal, **kw):
    if signal != "BRIEF" and task not in j.state["tasks"]:
        raise Reject("unknown-task", task)
    e = build(j, a, task, signal, **kw)
    r = j.append_message(e)
    t = j.state["tasks"].get(task)
    return "ok%s %s %s seq=%d status=%s msg=%s%s" % (
        " dup" if r["duplicate"] else "", signal, task, r["seq"], t["status"] if t else "-", e["messageId"],
        " cid=" + e["candidateId"] if e.get("candidateId") else "")


def controlled(j, a, action, task=None, **params):
    st = j.state
    room, sender = seat(a, st, task)
    c = {"controlId": a.id or uuid.uuid4().hex, "roomId": room, "by": sender, "action": action,
         "createdAt": iso(now_of(a)), "params": {k: v for k, v in params.items() if v is not None}}
    if task:
        c["taskId"] = task
    r = j.append_control(c)
    t = st["tasks"].get(task) if task else None
    return "ok%s control %s %s seq=%d%s ctl=%s" % (" dup" if r["duplicate"] else "", action, task or room, r["seq"],
                                                  " status=" + t["status"] if t else "", c["controlId"])


def seat_command(j, a):
    c = a.cmd
    if c == "brief":
        p = {"note": a.note}
        if a.review is not None or a.cid:
            p["kind"] = "review"
        else:
            if not a.root or not a.path:
                raise Usage("brief needs --root DIR and --path P (or --review)")
            p["writeScope"] = {"root": a.root, "paths": a.path}
            if a.lease:
                p["lease"] = {"expiresAt": a.lease}
            if a.depends:
                deps = []
                for d in a.depends:
                    tid, _, cid = d.partition(":")
                    deps.append({"taskId": tid, "candidateId": cid})
                p["dependsOn"] = deps
        return sent(j, a, a.task, "BRIEF", to=a.to, payload=p, cid=a.cid)
    if c == "candidate":
        i = {"base": a.base, "changedPaths": a.path, "evidenceRefs": a.evidence or []}
        if a.commit:
            i["commit"] = a.commit
        if a.patch_sha:
            i["patchSha256"] = a.patch_sha
        return sent(j, a, a.task, "CANDIDATE", payload={"identity": i, "patchFile": a.patch_file, "note": a.note},
                    cid=candidate_id(i))
    if c == "review":
        t = j.state["tasks"].get(a.task)
        cid = a.cid or (t["reviewOf"] if t else None)
        kind = a.kind or ("candidate" if cid else "other")
        return sent(j, a, a.task, "REVIEW", payload={"kind": kind, "note": a.note}, cid=cid if kind == "candidate" else None)
    if c == "accept":
        p = {"note": a.note}
        if a.waive:
            p["reviewWaived"] = a.waive
        else:
            rs = [m for m, v in j.state["reviews"].items() if v == (a.task, a.cid)]
            if rs:
                p["reviewMessageId"] = max(rs, key=lambda m: j.state["messages"][m]["seq"])
        return sent(j, a, a.task, "ACCEPT", payload=p, cid=a.cid)
    if c == "reject":
        own = "release" if a.release else ("reassign" if a.reassign else None)
        return sent(j, a, a.task, "REJECT", payload={"note": a.note, "ownership": own, "reassignTo": a.reassign}, cid=a.cid)
    if c == "send":
        sig = a.signal.upper().replace("_BRIEF", " BRIEF")
        return sent(j, a, a.task, sig, to=a.to, payload={"note": a.note, "owner": a.owner, "returnCondition": a.ret})
    if c == "control":
        act = a.action
        if act == "lead":
            return controlled(j, a, "lead", **{"from": a.from_, "to": a.to})
        kw = {}
        if act in ("transfer", "reconcile") and a.lease is not None:
            kw["lease"] = None if a.lease == "none" else a.lease
        if act == "transfer":
            kw["to"] = a.to
        if a.note:
            kw["note"] = a.note
        return controlled(j, a, act, a.task, **kw)
    raise Usage("unknown command")


SEAT_COMMANDS = ("brief", "candidate", "review", "accept", "reject", "send", "control")


def main(argv):
    ap = argparse.ArgumentParser(prog="slp-journal")
    ap.add_argument("--version", action="store_true")
    ap.add_argument("--self-check", action="store_true")
    ap.add_argument("--journal", default=os.environ.get("SLP_JOURNAL"))
    ap.add_argument("--now", default=None, help="override the clock (RFC3339 UTC Z): tests, replay")
    sub = ap.add_subparsers(dest="cmd")

    def seat_parser(name, task=True):
        s = sub.add_parser(name)
        if task:
            s.add_argument("task")
        s.add_argument("--as", dest="sender"); s.add_argument("--room"); s.add_argument("--id")
        s.add_argument("--cause"); s.add_argument("--note")
        return s
    s = sub.add_parser("append"); s.add_argument("file", nargs="?")
    s = sub.add_parser("deliver"); s.add_argument("message_id"); s.add_argument("state")
    sub.add_parser("state")
    sub.add_parser("contract")
    s = sub.add_parser("validate"); s.add_argument("file")
    s = sub.add_parser("candidate-id"); s.add_argument("file")
    s = sub.add_parser("scope-overlap")
    s.add_argument("--root", required=True); s.add_argument("--a", action="append", required=True)
    s.add_argument("--b", action="append", required=True)
    s = sub.add_parser("done-check"); s.add_argument("lead")
    s.add_argument("--running", action="append", default=[]); s.add_argument("--permission-pending", action="append", default=[])
    s = seat_parser("brief"); s.add_argument("--to", required=True); s.add_argument("--root"); s.add_argument("--path", action="append")
    s.add_argument("--lease"); s.add_argument("--depends", action="append"); s.add_argument("--review", nargs="?", const="", default=None)
    s.add_argument("--cid")
    s = seat_parser("candidate"); s.add_argument("--base", required=True); s.add_argument("--commit"); s.add_argument("--patch-sha")
    s.add_argument("--patch-file"); s.add_argument("--path", action="append", required=True); s.add_argument("--evidence", action="append")
    s = seat_parser("review"); s.add_argument("--cid"); s.add_argument("--kind", choices=REVIEW_KINDS)
    s = seat_parser("accept"); s.add_argument("--cid", required=True); s.add_argument("--waive")
    s = seat_parser("reject"); s.add_argument("--cid", required=True)
    g = s.add_mutually_exclusive_group(); g.add_argument("--release", action="store_true"); g.add_argument("--reassign")
    s = seat_parser("send"); s.add_argument("signal"); s.add_argument("--to"); s.add_argument("--owner"); s.add_argument("--return", dest="ret")
    s = sub.add_parser("control"); s.add_argument("action", choices=CONTROL_ACTIONS); s.add_argument("task", nargs="?")
    s.add_argument("--as", dest="sender"); s.add_argument("--room"); s.add_argument("--id"); s.add_argument("--cause")
    s.add_argument("--note"); s.add_argument("--to"); s.add_argument("--from", dest="from_"); s.add_argument("--lease")
    try:
        a = ap.parse_args(argv)
    except SystemExit as e:
        return 2 if e.code else 0
    try:
        if a.version:
            sys.stdout.write("slp-journal envelope-v%d\n" % ENVELOPE_VERSION)
            return 0
        if a.self_check:
            return out(self_check())
        if a.cmd is None:
            ap.print_usage(sys.stderr)
            return 2
        if a.cmd == "contract":
            return out(contract())
        if a.cmd == "validate":
            validate_envelope(read_json(a.file))
            return out({"ok": True})
        if a.cmd == "candidate-id":
            return out({"candidateId": candidate_id(read_json(a.file))})
        if a.cmd == "scope-overlap":
            rootc, pa = canon_scope(a.root, a.a)
            _, pb = canon_scope(a.root, a.b)
            return out({"overlap": paths_overlap(pa, pb), "root": rootc, "a": pa, "b": pb})
        if not a.journal:
            sys.stderr.write("slp-journal: --journal PATH or SLP_JOURNAL required\n")
            return 2
        if a.cmd == "control" and a.action != "lead" and not a.task:
            raise Usage("control %s needs a task" % a.action)
        with Journal(a.journal, write=a.cmd not in ("state", "done-check")) as j:
            if a.cmd == "state":
                r = public_state(j.state, now_of(a))
            elif a.cmd == "done-check":
                bl = open_loops(j.state, a.lead, now_of(a), a.running, a.permission_pending)
                if bl:
                    for b in bl:
                        line("blocker %s %s %s" % (b["type"], b["taskId"] or "-", b["detail"]))
                    return line("not-done: %d open loop(s)" % len(bl), 3)
                return line("ok done-check %s clean" % a.lead)
            elif a.cmd == "append":
                r = j.append_message(read_json(a.file))
            elif a.cmd == "deliver":
                r = j.deliver(a.message_id, a.state)
            else:
                return line(seat_command(j, a))
            if j.repaired:
                r["repaired"] = j.repaired
            return out(r)
    except Usage as e:
        sys.stderr.write("slp-journal: %s\n" % e)
        return 2
    except Reject as e:
        return out({"ok": False, "reason": e.reason, "detail": e.detail}, 3)
    except Corrupt as e:
        return out({"ok": False, "reason": e.reason, "detail": str(e)}, 4)
    except OSError as e:
        return out({"ok": False, "reason": "io-error", "detail": str(e)}, 4)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
