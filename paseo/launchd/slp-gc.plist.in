<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by install.sh from paseo/launchd/slp-gc.plist.in. Re-run install.sh to update; do not edit.
     Runs `slp-gc tick` every 60 s, independent of the Paseo daemon. It passes no apply or kill flag:
     what it reclaims or kills is decided by slp-gc.conf, read by tick itself. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@@LABEL@@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@@SLP_GC@@</string>
    <string>tick</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@@PATH@@</string>
    <key>HOME</key>
    <string>@@HOME@@</string>
    <key>SLP_GC_CONFIG</key>
    <string>@@CONFIG@@</string>@@EXTRA_ENV@@
  </dict>
  <key>StandardOutPath</key>
  <string>@@LOG@@</string>
  <key>StandardErrorPath</key>
  <string>@@LOG@@</string>
</dict>
</plist>
